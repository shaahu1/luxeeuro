NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Comma-separated Google emails allowed to open /admin
NEXT_PUBLIC_ADMIN_EMAILS=you@gmail.com
# Public site URL used in WhatsApp order links (https://yourdomain.com)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
# Resend API key for order confirmation emails (https://resend.com)
RESEND_API_KEY=
# Optional verified sender, e.g. LuXe Euro <orders@yourdomain.com>
ORDER_EMAIL_FROM=LuXe Euro <onboarding@resend.dev>
